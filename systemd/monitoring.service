[Unit]
Description=Monitoring HTTPS Endpoint
Description=Service that checks HTTPS endpoint status
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root

# Main script
ExecStart=/usr/local/bin/monitoring.sh

# Hooks for lifecycle events
ExecReloadPost=/usr/local/bin/monitoring-hooks.sh reload

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monitoring